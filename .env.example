# Copy to .env.local and fill in. Both are required before anything syncs.
# Without them the app is fully functional offline and reports "On this device".
#
# Only the anon key belongs in a client bundle. Never the service role key.
# See supabase/README.md for the schema and the storage bucket.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
